# JVM flags for the Skymoss server (Java 21) — REFERENCE ONLY.
#
# This file is NOT read by anything. It was written on the assumption that
# docker-compose loaded it, which it never did — the server ran with stock JVM
# settings and no GC tuning until that was noticed.
#
# The live configuration is USE_AIKAR_FLAGS=true in infra/docker-compose.yml, which
# generates essentially this same set and sizes it from MEMORY automatically. The
# few extras Aikar's set omits (metaspace sizing, ExitOnOutOfMemoryError) are passed
# through JVM_OPTS there.
#
# Kept because it documents why these flags are the right baseline: Aikar-derived G1
# tuning trades a little throughput for much shorter GC pauses, which is what
# actually matters when a pause shows up to players as a lag spike.

-XX:+UseG1GC
-XX:+ParallelRefProcEnabled
-XX:MaxGCPauseMillis=200
-XX:+UnlockExperimentalVMOptions
-XX:+DisableExplicitGC
-XX:+AlwaysPreTouch
-XX:G1NewSizePercent=30
-XX:G1MaxNewSizePercent=40
-XX:G1HeapRegionSize=8M
-XX:G1ReservePercent=20
-XX:G1HeapWastePercent=5
-XX:G1MixedGCCountTarget=4
-XX:InitiatingHeapOccupancyPercent=15
-XX:G1MixedGCLiveThresholdPercent=90
-XX:G1RSetUpdatingPauseTimePercent=5
-XX:SurvivorRatio=32
-XX:+PerfDisableSharedMem
-XX:MaxTenuringThreshold=1

# Mixin-heavy packs benefit from a larger metaspace; the default forces repeated
# metaspace GCs during mod load.
-XX:MetaspaceSize=256m
-XX:MaxMetaspaceSize=512m

# Fail fast and loudly rather than limping on after an OOM.
-XX:+ExitOnOutOfMemoryError

-Dfml.readTimeout=180
-Dfile.encoding=UTF-8
