# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Minecraft ---------------------------------------------------------------
MINECRAFT_VERSION=1.21.1
NEOFORGE_VERSION=21.1.241
MC_MEMORY=8G
# Loaded from server/jvm.args; see that file for rationale.
MC_JVM_OPTS=
RCON_PASSWORD=
TZ=America/Los_Angeles

# Where the server reads the pack manifest. The default points at the mirror over the
# internal compose network, which needs no domain and no public hostname. Only set
# this if you are serving the manifest from somewhere external.
# PACKWIZ_URL=http://mirror/pack/pack.toml

# --- Player ingress ----------------------------------------------------------
# Cloudflare Tunnel cannot carry Minecraft — it is raw TCP, and Cloudflare proxies
# arbitrary TCP only on Enterprise Spectrum.
#
# This host has a routable WAN address (not CGNAT), so players connect by
# port-forwarding TCP 25565 on the router. DuckDNS supplies a stable hostname so
# they type a name rather than an IP that changes.
#
# Register a free subdomain at https://www.duckdns.org — sign in, create one, and
# copy the token shown at the top of the page.
# Enter the subdomain WITHOUT the .duckdns.org suffix, e.g. "skymoss".
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- playit.gg (optional fallback, only needed behind CGNAT) ------------------
# Not started by default. Opt in with:  docker compose --profile playit up -d
#
# Generate the secret on the web first — the container has no interactive claim
# flow, and an empty value is read as a bad credential rather than "unclaimed",
# which crash-loops the service:
#   https://playit.gg/account/setup/wizard/new-account/docker/docker-name
PLAYIT_SECRET_KEY=

# 1.0.10 / :latest cannot fall back from IPv6 to IPv4, so on an IPv4-only host the
# relay accepts players and immediately resets them (playit-cloud/playit-agent#194,
# still open). 1.0.8 predates that code; 1.0.7 also connects cleanly. Never go
# below 1.0.x — the 0.x line cannot authenticate at all.
PLAYIT_AGENT_VERSION=1.0.8

# --- Mirror ------------------------------------------------------------------
# Host path holding the mirror tree: /srv/mirror/mods/*.jar and /srv/mirror/pack/
MIRROR_ROOT=/srv/mirror

# --- Cloudflare tunnel (optional) --------------------------------------------
# Only useful if you own a domain on Cloudflare. Enable with:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Forum channel where one thread is created per GitHub issue.
DISCORD_ISSUE_CHANNEL_ID=
# Text channel for CI/CD and release notifications.
DISCORD_CI_CHANNEL_ID=

# --- GitHub ------------------------------------------------------------------
# Fine-grained PAT with Issues: read/write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=jerezereh/skymoss-minceraft

# Webhooks require a public hostname for GitHub to POST to. With no domain, leave
# this empty and rely on polling below. If set, it must match the secret on the repo
# webhook exactly.
GITHUB_WEBHOOK_SECRET=

# Seconds between GitHub polls. This is how GitHub→Discord works without a public
# hostname. 0 disables it. Costs ~2% of the API rate limit at 60s.
GITHUB_POLL_INTERVAL=60
# Shared secret for the /events endpoint; set the same value as the
# CI_EVENT_SECRET repository secret in GitHub Actions.
CI_EVENT_SECRET=

# --- Monitoring --------------------------------------------------------------
# Bearer token for the bridge's /alerts endpoint. Paste the same value into each
# Uptime Kuma notification as an Authorization: Bearer <token> header.
# Generate with: openssl rand -hex 32
ALERT_TOKEN=

# --- Discord admin commands --------------------------------------------------
# Role ID allowed to run /restart and /cmd. Leave empty to disable both entirely.
# /cmd is a full server console — it can op, ban, and stop the server — so grant
# this role only to people you'd trust with SSH access.
ADMIN_ROLE_ID=

# --- World snapshots ---------------------------------------------------------
WORLDS_REPO=git@github.com:jerezereh/skymoss-worlds.git
WORLD_NAME=FlyMoss
