# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Minecraft ---------------------------------------------------------------
MINECRAFT_VERSION=1.21.1
NEOFORGE_VERSION=21.1.241
MC_MEMORY=8G
# Loaded from server/jvm.args; see that file for rationale.
MC_JVM_OPTS=
RCON_PASSWORD=
TZ=America/Los_Angeles

# Where the server reads the pack manifest. The default points at the mirror over the
# internal compose network, which needs no domain and no public hostname. Only set
# this if you are serving the manifest from somewhere external.
# PACKWIZ_URL=http://mirror/pack/pack.toml

# --- Player ingress ----------------------------------------------------------
# Cloudflare Tunnel cannot carry Minecraft — it is raw TCP, and Cloudflare proxies
# arbitrary TCP only on Enterprise Spectrum.
#
# This host has a routable WAN address (not CGNAT), so players connect by
# port-forwarding TCP 25565 on the router. DuckDNS supplies a stable hostname so
# they type a name rather than an IP that changes.
#
# Register a free subdomain at https://www.duckdns.org — sign in, create one, and
# copy the token shown at the top of the page.
# Enter the subdomain WITHOUT the .duckdns.org suffix, e.g. "skymoss".
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- playit.gg (optional fallback, only needed behind CGNAT) ------------------
# Not started by default. Opt in with:  docker compose --profile playit up -d
#
# Generate the secret on the web first — the container has no interactive claim
# flow, and an empty value is read as a bad credential rather than "unclaimed",
# which crash-loops the service:
#   https://playit.gg/account/setup/wizard/new-account/docker/docker-name
PLAYIT_SECRET_KEY=

# 1.0.10 / :latest cannot fall back from IPv6 to IPv4, so on an IPv4-only host the
# relay accepts players and immediately resets them (playit-cloud/playit-agent#194,
# still open). 1.0.8 predates that code; 1.0.7 also connects cleanly. Never go
# below 1.0.x — the 0.x line cannot authenticate at all.
PLAYIT_AGENT_VERSION=1.0.8

# --- Mirror ------------------------------------------------------------------
# Host path holding the mirror tree: /srv/mirror/mods/*.jar and /srv/mirror/pack/
MIRROR_ROOT=/srv/mirror

# --- Cloudflare tunnel (optional) --------------------------------------------
# Only useful if you own a domain on Cloudflare. Enable with:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# --- Discord -----------------------------------------------------------------
# The BOT TOKEN, not the Client Secret. A Discord app exposes several credentials
# and only this one logs in a bot:
#   Bot Token      three dot-separated parts, ~70 chars   <- this one
#   Client Secret  single ~32-char string (OAuth2 user flows, not bots)
#
# Developer Portal -> your app -> Bot -> Token -> Reset Token. Discord shows it
# once; resetting is the only way to see it again.
#
# Also on that page, enable MESSAGE CONTENT INTENT under Privileged Gateway
# Intents. Without it the bot logs in fine but receives empty message bodies, so
# Discord -> GitHub silently relays nothing.
#
# Invite the bot with BOTH the `bot` and `applications.commands` scopes, or slash
# command registration fails.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Forum channel where one thread is created per GitHub issue.
DISCORD_ISSUE_CHANNEL_ID=
# Text channel for development activity: pull requests opened, build results,
# releases. Safe to mute.
DISCORD_CI_CHANNEL_ID=
# Text channel for things that are broken right now: Uptime Kuma monitor alerts and
# failed builds on main. Turn notifications ON for this one.
#
# The split exists because Discord's notification settings are per-channel. Sharing
# one channel means choosing between muting a 3am outage and being pinged for every
# pull request — and routine traffic is what trains you to ignore the alert.
#
# Optional. Unset, alerts fall back to DISCORD_CI_CHANNEL_ID and behave as before.
DISCORD_ALERT_CHANNEL_ID=

# --- GitHub ------------------------------------------------------------------
# Fine-grained PAT with Issues: read/write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=jerezereh/skymoss-minceraft

# Webhooks require a public hostname for GitHub to POST to. With no domain, leave
# this empty and rely on polling below. If set, it must match the secret on the repo
# webhook exactly.
GITHUB_WEBHOOK_SECRET=

# Seconds between GitHub polls. This is how GitHub→Discord works without a public
# hostname. 0 disables it. Costs ~2% of the API rate limit at 60s.
GITHUB_POLL_INTERVAL=60
# Shared secret for the /events endpoint; set the same value as the
# CI_EVENT_SECRET repository secret in GitHub Actions.
CI_EVENT_SECRET=

# --- Monitoring --------------------------------------------------------------
# Bearer token for the bridge's /alerts endpoint. Paste the same value into each
# Uptime Kuma notification as an Authorization: Bearer <token> header.
# Generate with: openssl rand -hex 32
ALERT_TOKEN=

# Push URL of an Uptime Kuma "Push" monitor, pinged after every completed poll tick.
#
# A dead man's switch. /health only reports that the web server is listening, so a
# hung poll leaves the bridge monitor green while GitHub activity silently stops
# reaching Discord — and an empty #ci looks exactly like a quiet day. Only the
# absence of an expected heartbeat detects it.
#
# Use the container name, not localhost:
#   http://uptime-kuma:3001/api/push/<token>
KUMA_POLLER_PUSH_URL=

# --- Discord admin commands --------------------------------------------------
# Role ID allowed to run /restart and /cmd. Leave empty to disable both entirely.
# /cmd is a full server console — it can op, ban, and stop the server — so grant
# this role only to people you'd trust with SSH access.
ADMIN_ROLE_ID=

# --- Backups (restic -> Cloudflare R2) ---------------------------------------
# Hourly, deduplicated, encrypted, offsite. Skipped automatically when no players
# are online.
#
# Setup:
#   1. Cloudflare dashboard -> R2 -> create a bucket, e.g. "skymoss-backups"
#   2. R2 -> Manage API Tokens -> create a token with Object Read & Write
#   3. Fill in below, then initialise the repo once from the host:
#        docker run --rm -e RESTIC_REPOSITORY -e RESTIC_PASSWORD \
#          -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY \
#          restic/restic init
#
# RESTIC_PASSWORD encrypts the backups. Losing it means losing every backup —
# there is no recovery path. Store it somewhere separate from this server.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/skymoss-backups
RESTIC_PASSWORD=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

BACKUP_INTERVAL=1h

# Dead man's switch for backup cadence. Create a "Push" monitor in Uptime Kuma,
# copy its Push URL, and paste it here. The backup pings it after every run, and
# Kuma alerts when the ping stops arriving — which is the only way to detect a
# backup that silently never happened.
#
# Use the container name, not localhost:
#   http://uptime-kuma:3001/api/push/<token>
KUMA_BACKUP_PUSH_URL=

# Dense recent history thinning with age. Unlike Git LFS, pruning genuinely
# reclaims storage here.
#
# The quotes are load-bearing. Compose's .env parser takes an unquoted value
# verbatim, but `. ./.env` in a shell does not: it would assign
# RESTIC_RETENTION=--keep-hourly and then try to run `24` as a command.
RESTIC_RETENTION="--keep-hourly 24 --keep-daily 14 --keep-weekly 8 --keep-monthly 12"

# --- Scheduled restart -------------------------------------------------------
# Hour (0-23, local TZ) for the nightly restart. Players get 15/5/1-minute
# warnings, then the world is flushed and the server stopped; Docker's restart
# policy brings it back.
RESTART_HOUR=5

